#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
# shellcheck source=.githooks/lib/githooks.sh
. "$repo_root/.githooks/lib/githooks.sh"

# One-shot hook builds: disable incremental so stale caches cannot rot into
# rust-lld "undefined hidden symbol" link failures or unbounded target/ growth.
export CARGO_INCREMENTAL=0

needs_rust_checks=0

collect_check_scope() {
    local file
    while IFS= read -r file; do
        [[ -z "$file" ]] && continue

        case "$file" in
            *.rs|Cargo.toml|Cargo.lock|rustfmt.toml|crates/*/Cargo.toml|crates/*/build.rs|crates/*/src/*|crates/*/tests/*|crates/*/benches/*)
                needs_rust_checks=1
                ;;
            *)
                ;;
        esac
    done < <(git diff --cached --name-only --diff-filter=ACMR)
}

githooks_installed_dir() {
    if [ -n "${EE_GITHOOKS_INSTALLED_DIR:-}" ]; then
        printf '%s\n' "${EE_GITHOOKS_INSTALLED_DIR}"
        return 0
    fi
    printf '%s\n' "$repo_root/.git/hooks"
}

# Warn (never block) when the installed hook copy is older than the repo's
# .githooks/: hooks install by copying, so pulls and edits leave .git/hooks
# stale until `mk install-githooks` is re-run.
check_hooks_drift() {
    local installed_dir file drifted=0
    installed_dir="$(githooks_installed_dir)"
    [[ -d "$installed_dir" ]] || return 0
    for file in pre-commit lib/githooks.sh record-tests-pass; do
        if ! cmp -s "$repo_root/.githooks/$file" "$installed_dir/$file" 2>/dev/null; then
            drifted=1
            echo "[pre-commit] warning: installed .git/hooks/$file is out of date"
        fi
    done
    if [[ "$drifted" -eq 1 ]]; then
        echo "[pre-commit] hint: reinstall hooks with: mk install-githooks"
    fi
}

run_docs_check() {
    # Full workspace, exactly the CI docs job: a scoped run would miss broken
    # links in untouched crates until CI documents the whole workspace.
    echo "[pre-commit] docs check"
    RUSTDOCFLAGS="-D warnings" cargo doc --workspace --all-features --no-deps --locked
}

main() {
    check_hooks_drift
    collect_check_scope

    if [[ "$needs_rust_checks" -eq 1 || "${ATLAS_PRE_COMMIT_FULL:-0}" == "1" ]]; then
        echo "[pre-commit] format check"
        cargo fmt --all --check

        echo "[pre-commit] lint (--workspace)"
        cargo clippy --workspace --all-targets --all-features -- -D warnings

        run_docs_check

        # State-gated full workspace test: tests run once per tree change —
        # either here or outside the commit via `mk ci` / record-tests-pass —
        # then skip until test-relevant file contents change again. State
        # lives in target/.githooks-state (gitignored).
        test_cmd="$(githooks_test_cmd)"
        state_key="$(githooks_compute_key)"
        if githooks_state_matches "$test_cmd" "$state_key"; then
            echo "[pre-commit] tests skipped: workspace test suite already passed for this tree"
        else
            echo "[pre-commit] run workspace test suite ($test_cmd)"
            # Intentional word splitting: the canonical command is stored and
            # executed as separate arguments.
            # shellcheck disable=SC2086
            $test_cmd
            githooks_record_pass "$test_cmd" "$state_key"
            echo "[pre-commit] tests passed; state recorded in target/.githooks-state"
        fi
    else
        echo "[pre-commit] no Rust changes staged; skipping cargo fmt/clippy/docs/test"
    fi

    # atlas-hook start

    # Installed by atlas. Remove these lines to disable atlas graph updates.
    if command -v atlas >/dev/null 2>&1; then
        atlas update || true
        atlas detect-changes || true
    fi
    echo "[pre-commit] complete"
    # atlas-hook end
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi