{
  "$defs": {
    "Activation": {
      "description": "Activation conditions.",
      "properties": {
        "on_command": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "on_event": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "on_language": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "on_startup": {
          "default": false,
          "type": "boolean"
        },
        "scopes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScopeTarget"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "AgentContributions": {
      "description": "Agent contributions.",
      "properties": {
        "context_providers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContextProviderContribution"
          },
          "type": "array"
        },
        "model_providers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelProviderContribution"
          },
          "type": "array"
        },
        "policy_rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PolicyRuleContribution"
          },
          "type": "array"
        },
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AgentToolContribution"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "AgentToolContribution": {
      "description": "Agent tool descriptor.",
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parameters_schema": true,
        "scope": {
          "$ref": "#/$defs/AgentToolScope",
          "default": "host"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "parameters_schema"
      ],
      "type": "object"
    },
    "AgentToolScope": {
      "description": "Lifetime of an agent tool contribution.",
      "enum": [
        "host",
        "session",
        "turn"
      ],
      "type": "string"
    },
    "CommandContribution": {
      "description": "Command contributed to the palette and keymap.",
      "properties": {
        "args_schema": {
          "default": null
        },
        "category": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/CommandId"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "CommandId": {
      "description": "Identifier for a command registered by a plugin.",
      "type": "string"
    },
    "ConfigSchema": {
      "description": "Plugin configuration schema and defaults.",
      "properties": {
        "defaults": {
          "default": null
        },
        "schema": {
          "default": null
        }
      },
      "type": "object"
    },
    "ConfigSchemaContribution": {
      "description": "Plugin configuration section contributed to the host schema.",
      "properties": {
        "section": {
          "type": "string"
        }
      },
      "required": [
        "section"
      ],
      "type": "object"
    },
    "ContextProviderContribution": {
      "description": "Agent context provider descriptor.",
      "properties": {
        "id": {
          "type": "string"
        },
        "max_bytes": {
          "default": 16384,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel"
        }
      },
      "required": [
        "id",
        "trust"
      ],
      "type": "object"
    },
    "ContributionId": {
      "description": "Identifier for one declarative contribution.",
      "type": "string"
    },
    "Contributions": {
      "description": "Declarative contribution tables.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentContributions",
          "default": {
            "context_providers": [],
            "model_providers": [],
            "policy_rules": [],
            "tools": []
          }
        },
        "commands": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CommandContribution"
          },
          "type": "array"
        },
        "config_schema": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ConfigSchemaContribution"
          },
          "type": "array"
        },
        "ex_commands": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExCommandContribution"
          },
          "type": "array"
        },
        "formatters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FormatterContribution"
          },
          "type": "array"
        },
        "keybindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KeybindingContribution"
          },
          "type": "array"
        },
        "languages": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LanguageContribution"
          },
          "type": "array"
        },
        "lsp_servers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LspServerContribution"
          },
          "type": "array"
        },
        "menu_items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MenuItemContribution"
          },
          "type": "array"
        },
        "ui": {
          "$ref": "#/$defs/UiContributions",
          "default": {
            "overlays": [],
            "panels": [],
            "pickers": [],
            "status_items": []
          }
        }
      },
      "type": "object"
    },
    "ExCommandContribution": {
      "description": "Ex command alias.",
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "$ref": "#/$defs/CommandId"
        },
        "name": {
          "type": "string"
        },
        "usage": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "command"
      ],
      "type": "object"
    },
    "FilterMode": {
      "description": "Picker filtering strategy.",
      "enum": [
        "substring",
        "fuzzy",
        "regex"
      ],
      "type": "string"
    },
    "FormatterContribution": {
      "description": "Formatter descriptor.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": "string"
        },
        "extensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/ContributionId"
        }
      },
      "required": [
        "id",
        "command"
      ],
      "type": "object"
    },
    "HostTarget": {
      "description": "Host that loads the plugin.",
      "enum": [
        "editor",
        "agent"
      ],
      "type": "string"
    },
    "KeybindingContribution": {
      "description": "Default key binding contributed beneath user bindings.",
      "properties": {
        "command": {
          "$ref": "#/$defs/CommandId"
        },
        "key": {
          "type": "string"
        },
        "when": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command",
        "key"
      ],
      "type": "object"
    },
    "LanguageContribution": {
      "description": "Language definition contributed by a language plugin.",
      "properties": {
        "default_config": {
          "default": null
        },
        "extensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "filenames": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "first_line_match": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "globs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "scope": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "LaunchConfig": {
      "description": "Native launch parameters. Wasm plugins ignore these fields.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "transport": {
          "$ref": "#/$defs/LaunchTransport",
          "default": "stdio_newline"
        },
        "working_dir": {
          "default": ".",
          "type": "string"
        }
      },
      "type": "object"
    },
    "LaunchTransport": {
      "description": "Native transport used to speak the v2 wire protocol.",
      "enum": [
        "stdio_newline",
        "stdio_content_length"
      ],
      "type": "string"
    },
    "Limits": {
      "description": "Runtime resource limits.",
      "properties": {
        "max_contributions": {
          "default": 128,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_cpu_seconds": {
          "default": 10,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_memory_bytes": {
          "default": 67108864,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rpc_timeout_ms": {
          "default": 2000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "LspServerContribution": {
      "description": "LSP server descriptor.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "language",
        "command"
      ],
      "type": "object"
    },
    "MenuItemContribution": {
      "description": "Menu entry pointing at a command.",
      "properties": {
        "command": {
          "$ref": "#/$defs/CommandId"
        },
        "group": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "order": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "command",
        "label"
      ],
      "type": "object"
    },
    "ModelProviderContribution": {
      "description": "Model provider descriptor.",
      "properties": {
        "capabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "OverlayAnchor": {
      "description": "Anchor for an overlay.",
      "enum": [
        "cursor",
        "top_left",
        "top_right",
        "bottom_left",
        "bottom_right",
        "center"
      ],
      "type": "string"
    },
    "OverlayContribution": {
      "description": "Overlay descriptor.",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/OverlayAnchor"
        },
        "id": {
          "$ref": "#/$defs/ContributionId"
        },
        "render": {
          "$ref": "#/$defs/RenderSpec"
        },
        "transient": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "anchor",
        "render"
      ],
      "type": "object"
    },
    "PanelContribution": {
      "description": "Panel descriptor.",
      "properties": {
        "data_provider": {
          "default": false,
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/ContributionId"
        },
        "placement": {
          "$ref": "#/$defs/PanelPlacement"
        },
        "render": {
          "$ref": "#/$defs/RenderSpec"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "placement",
        "render"
      ],
      "type": "object"
    },
    "PanelPlacement": {
      "description": "Panel placement requested from the frontend.",
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "center"
      ],
      "type": "string"
    },
    "Permissions": {
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Declared permissions. Every value must be `true`.",
      "type": "object"
    },
    "PickerColumn": {
      "description": "One picker column.",
      "properties": {
        "key": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "title"
      ],
      "type": "object"
    },
    "PickerContribution": {
      "description": "Picker descriptor.",
      "properties": {
        "columns": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PickerColumn"
          },
          "type": "array"
        },
        "data_provider": {
          "default": false,
          "type": "boolean"
        },
        "filter_mode": {
          "$ref": "#/$defs/FilterMode",
          "default": "substring"
        },
        "id": {
          "$ref": "#/$defs/ContributionId"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "PluginKind": {
      "description": "Plugin implementation kind.",
      "enum": [
        "builtin",
        "native",
        "wasm"
      ],
      "type": "string"
    },
    "PolicyGate": {
      "description": "Policy gate class.",
      "enum": [
        "observe",
        "gate"
      ],
      "type": "string"
    },
    "PolicyRuleContribution": {
      "description": "Agent policy rule descriptor.",
      "properties": {
        "gate": {
          "$ref": "#/$defs/PolicyGate"
        },
        "id": {
          "type": "string"
        },
        "precedence": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "gate"
      ],
      "type": "object"
    },
    "Provides": {
      "description": "Services provided by the plugin.",
      "properties": {
        "services": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "RenderSpec": {
      "description": "Declarative renderer for a panel or overlay.",
      "oneOf": [
        {
          "properties": {
            "empty_text": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "markdown",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Requires": {
      "description": "Required and optional service dependencies.",
      "properties": {
        "optional_services": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "services": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ScopeTarget": {
      "description": "Scope lifetime targets.",
      "enum": [
        "host",
        "workspace",
        "buffer",
        "view",
        "session",
        "turn",
        "command"
      ],
      "type": "string"
    },
    "StatusAlignment": {
      "description": "Horizontal alignment for a status item.",
      "enum": [
        "left",
        "right"
      ],
      "type": "string"
    },
    "StatusItemContribution": {
      "description": "Status bar item.",
      "properties": {
        "alignment": {
          "$ref": "#/$defs/StatusAlignment"
        },
        "key": {
          "type": "string"
        },
        "priority": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "text",
        "alignment"
      ],
      "type": "object"
    },
    "TrustLevel": {
      "description": "Trust level attached to contributed agent context.",
      "enum": [
        "untrusted",
        "workspace",
        "trusted"
      ],
      "type": "string"
    },
    "UiContributions": {
      "description": "UI contributions.",
      "properties": {
        "overlays": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OverlayContribution"
          },
          "type": "array"
        },
        "panels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PanelContribution"
          },
          "type": "array"
        },
        "pickers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PickerContribution"
          },
          "type": "array"
        },
        "status_items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StatusItemContribution"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Complete v2 manifest.",
  "properties": {
    "activation": {
      "$ref": "#/$defs/Activation",
      "default": {
        "on_command": [],
        "on_event": [],
        "on_language": [],
        "on_startup": false,
        "scopes": []
      }
    },
    "api": {
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/ConfigSchema",
      "default": {
        "defaults": null,
        "schema": null
      }
    },
    "contributes": {
      "$ref": "#/$defs/Contributions",
      "default": {
        "agent": {
          "context_providers": [],
          "model_providers": [],
          "policy_rules": [],
          "tools": []
        },
        "commands": [],
        "config_schema": [],
        "ex_commands": [],
        "formatters": [],
        "keybindings": [],
        "languages": [],
        "lsp_servers": [],
        "menu_items": [],
        "ui": {
          "overlays": [],
          "panels": [],
          "pickers": [],
          "status_items": []
        }
      }
    },
    "entry": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/PluginKind"
    },
    "launch": {
      "$ref": "#/$defs/LaunchConfig",
      "default": {
        "args": [],
        "env": {},
        "transport": "stdio_newline",
        "working_dir": ""
      }
    },
    "limits": {
      "$ref": "#/$defs/Limits",
      "default": {
        "max_contributions": 128,
        "max_cpu_seconds": 10,
        "max_memory_bytes": 67108864,
        "rpc_timeout_ms": 2000
      }
    },
    "manifest_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "permissions": {
      "$ref": "#/$defs/Permissions",
      "default": {}
    },
    "provides": {
      "$ref": "#/$defs/Provides",
      "default": {
        "services": []
      }
    },
    "requires": {
      "$ref": "#/$defs/Requires",
      "default": {
        "optional_services": [],
        "services": []
      }
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/HostTarget"
      },
      "type": "array"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "manifest_version",
    "name",
    "version",
    "api",
    "targets",
    "kind",
    "entry"
  ],
  "title": "ManifestV2",
  "type": "object"
}