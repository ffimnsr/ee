{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EeToml",
  "description": "Raw `.ee.toml` shape; all fields optional so partial files work.",
  "type": "object",
  "properties": {
    "root": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "indent_style": {
      "description": "`\"spaces\"` or `\"tabs\"` (aliases: `\"space\"`, `\"tab\"`).",
      "type": [
        "string",
        "null"
      ]
    },
    "indent_size": {
      "description": "Number of spaces per indent level.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint",
      "minimum": 0
    },
    "tab_width": {
      "description": "Visual width of a hard-tab character.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint",
      "minimum": 0
    },
    "end_of_line": {
      "description": "`\"lf\"`, `\"crlf\"`, or `\"cr\"`.",
      "type": [
        "string",
        "null"
      ]
    },
    "charset": {
      "description": "Expected charset, e.g. `\"utf-8\"`.",
      "type": [
        "string",
        "null"
      ]
    },
    "trim_trailing_whitespace": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "insert_final_newline": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "auto_indent": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "smart_indent": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "number_style": {
      "description": "`\"absolute\"`, `\"relative\"`, or `\"relative_absolute\"`.",
      "type": [
        "string",
        "null"
      ]
    },
    "color_column": {
      "description": "Column position for the color column guide (e.g. `80`).  Omit to disable.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint",
      "minimum": 0
    },
    "show_visible_whitespace": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "scroll_offset": {
      "description": "Minimum rows between cursor and screen top/bottom edge.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint",
      "minimum": 0
    },
    "wrap_lines": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "sign_column": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "cursor_line": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "statusline_format": {
      "description": "`\"default\"` or `\"minimal\"`.",
      "type": [
        "string",
        "null"
      ]
    },
    "lsp": {
      "anyOf": [
        {
          "$ref": "#/$defs/LspToml"
        },
        {
          "type": "null"
        }
      ]
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RuntimeLanguageConfig"
      },
      "default": {}
    },
    "keymap": {
      "anyOf": [
        {
          "$ref": "#/$defs/KeymapToml"
        },
        {
          "type": "null"
        }
      ]
    },
    "agents": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentsToml"
        },
        {
          "type": "null"
        }
      ]
    },
    "mcp": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpToml"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "LspToml": {
      "type": "object",
      "properties": {
        "servers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/LspServerToml"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "LspServerToml": {
      "type": "object",
      "properties": {
        "language_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "filenames": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "supports_single_file": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "workspace_identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "initialization_options": true
      },
      "additionalProperties": false
    },
    "RuntimeLanguageConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "lsp": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "query_language": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "scope": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "content_regex": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "first_line_regex": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "injection_regex": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "aliases": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "file_types": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "globs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "shebangs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "supported_query_kinds": {
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/RuntimeQueryKind"
          },
          "default": null
        },
        "match_priority": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32",
          "default": null
        },
        "grammar": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeGrammarConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "RuntimeQueryKind": {
      "type": "string",
      "enum": [
        "highlights",
        "injections",
        "locals",
        "tags",
        "textobjects",
        "indents",
        "folds",
        "rainbows"
      ]
    },
    "RuntimeGrammarConfig": {
      "type": "object",
      "properties": {
        "library": {
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeGrammarSource"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RuntimeGrammarSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "crate": {
              "$ref": "#/$defs/RuntimeGrammarCrateSource"
            }
          },
          "required": [
            "crate"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "git": {
              "$ref": "#/$defs/RuntimeGrammarGitSource"
            }
          },
          "required": [
            "git"
          ],
          "additionalProperties": false
        }
      ]
    },
    "RuntimeGrammarCrateSource": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ]
    },
    "RuntimeGrammarGitSource": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "rev": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "oneOf": [
        {
          "required": [
            "branch"
          ]
        },
        {
          "required": [
            "tag"
          ]
        },
        {
          "required": [
            "rev"
          ]
        }
      ]
    },
    "KeymapToml": {
      "type": "object",
      "properties": {
        "inherit_defaults": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sequence_timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "unbind": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyBindingTargetToml"
          },
          "default": []
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyBindingEntryToml"
          },
          "default": []
        },
        "sequence_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeySequenceBindingToml"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "KeyBindingTargetToml": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "key"
      ]
    },
    "KeyBindingEntryToml": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "key",
        "action"
      ]
    },
    "KeySequenceBindingToml": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "keys",
        "action"
      ]
    },
    "AgentsToml": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Runtime switch for agents mode.  Defaults to `false`; agents mode is\ndisabled unless a config layer sets this to `true`.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "default_agent": {
          "description": "Agent server id used when the user starts a session without choosing\nan explicit agent.",
          "type": [
            "string",
            "null"
          ]
        },
        "servers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AgentServerToml"
          },
          "default": {}
        },
        "web_context": {
          "description": "Trusted configuration for optional agent web retrieval. Only user-global\nconfig can grant access; workspace files can only disable or restrict it.",
          "anyOf": [
            {
              "$ref": "#/$defs/AgentWebContextToml"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "AgentServerToml": {
      "description": "Raw `[agents.servers.<id>]` definition.",
      "type": "object",
      "properties": {
        "command": {
          "description": "Executable invoked to start the ACP agent subprocess.",
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "env": {
          "description": "Environment variables for the agent subprocess. An exact\n`secret://<name>` value is resolved from the host-bound encrypted\nsecrets store (`ee do secrets`) only when the agent launches, and only\nwhen the value comes from a user config layer (XDG or legacy user\nconfig); system and workspace config layers cannot reference secrets.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "cwd": {
          "description": "Working directory for the agent subprocess; inherits `ee` when unset.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "AgentWebContextToml": {
      "description": "Raw `[agents.web_context]` definition. A user-global opaque provider secret\nreference is resolved only when web search service construction needs it.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enables optional web retrieval. Defaults to `false`.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "backend": {
          "description": "Selected trusted search provider.",
          "anyOf": [
            {
              "$ref": "#/$defs/WebContextBackendToml"
            },
            {
              "type": "null"
            }
          ]
        },
        "endpoint": {
          "description": "HTTPS endpoint for SearXNG only.",
          "type": [
            "string",
            "null"
          ]
        },
        "hosts": {
          "description": "Exact hosts preapproved by user-global configuration.",
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "description": "Bounded response, text, search-result, redirect, timeout, and concurrency limits.",
          "anyOf": [
            {
              "$ref": "#/$defs/WebContextLimitsToml"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_secret_reference": {
          "description": "Exact `secret://<name>` reference accepted only from user-global config.\nIt remains opaque until lazy web-search service construction.",
          "type": [
            "string",
            "null"
          ]
        },
        "browser_run_account_id": {
          "description": "Cloudflare account id for Browser Run. Browser Run stays disabled unless\nthis and `browser_run_api_token_reference` are configured user-globally.",
          "type": [
            "string",
            "null"
          ]
        },
        "browser_run_api_token_reference": {
          "description": "Exact `secret://<name>` reference for Cloudflare Browser Run API token.",
          "type": [
            "string",
            "null"
          ]
        },
        "browser_run_max_attempts": {
          "description": "Total Browser Run attempts, including initial request. Defaults to 3; max 5.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "browser_run_base_delay_ms": {
          "description": "Exponential fallback delay before first retry. Defaults to 500 ms.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "browser_run_max_delay_ms": {
          "description": "Cap for Retry-After and exponential retry delay. Defaults to 10_000 ms.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "exa": {
          "description": "Exa-specific search options. Valid only when `backend = \"exa\"`.",
          "anyOf": [
            {
              "$ref": "#/$defs/ExaSearchOptionsToml"
            },
            {
              "type": "null"
            }
          ]
        },
        "brave_llm_context": {
          "description": "Brave LLM Context-specific search options. Valid only when\n`backend = \"brave_llm_context\"`.",
          "anyOf": [
            {
              "$ref": "#/$defs/BraveLlmContextOptionsToml"
            },
            {
              "type": "null"
            }
          ]
        },
        "tavily": {
          "description": "Tavily-specific search options. Valid only when `backend = \"tavily\"`.",
          "anyOf": [
            {
              "$ref": "#/$defs/TavilySearchOptionsToml"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "WebContextBackendToml": {
      "type": "string",
      "enum": [
        "searxng",
        "exa",
        "brave_llm_context",
        "tavily"
      ]
    },
    "WebContextLimitsToml": {
      "type": "object",
      "properties": {
        "max_response_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "max_text_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "max_search_results": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "max_redirects": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "request_timeout_ms": {
          "description": "Total request timeout in milliseconds.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "max_concurrent_requests": {
          "description": "Maximum simultaneous web requests.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ExaSearchOptionsToml": {
      "type": "object",
      "properties": {
        "max_results": {
          "description": "Maximum results. Defaults to bounded host result limit.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "search_mode": {
          "description": "Exa search mode. Defaults to `auto`; result highlights remain enabled by adapter policy.",
          "anyOf": [
            {
              "$ref": "#/$defs/ExaSearchModeToml"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ExaSearchModeToml": {
      "type": "string",
      "enum": [
        "auto",
        "neural",
        "fast"
      ]
    },
    "BraveLlmContextOptionsToml": {
      "type": "object",
      "properties": {
        "max_results": {
          "description": "Bounded cited result count.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "max_tokens": {
          "description": "Bounded grounding token budget, clamped to host text limit.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "max_urls": {
          "description": "Bounded cited URL count.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "max_snippets": {
          "description": "Bounded grounding snippet count.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "threshold_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/BraveThresholdModeToml"
            },
            {
              "type": "null"
            }
          ]
        },
        "freshness": {
          "anyOf": [
            {
              "$ref": "#/$defs/BraveFreshnessToml"
            },
            {
              "type": "null"
            }
          ]
        },
        "safe_search": {
          "description": "Safe-search mode. Local recall is deliberately unavailable.",
          "anyOf": [
            {
              "$ref": "#/$defs/BraveSafeSearchModeToml"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "BraveThresholdModeToml": {
      "type": "string",
      "enum": [
        "balanced",
        "strict"
      ]
    },
    "BraveFreshnessToml": {
      "type": "string",
      "enum": [
        "any",
        "day",
        "week",
        "month"
      ]
    },
    "BraveSafeSearchModeToml": {
      "type": "string",
      "enum": [
        "off",
        "moderate",
        "strict"
      ]
    },
    "TavilySearchOptionsToml": {
      "type": "object",
      "properties": {
        "max_results": {
          "description": "Maximum results. Defaults to bounded host result limit.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "chunks_per_source": {
          "description": "Chunks per source. Defaults to `3` and cannot exceed it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "search_depth": {
          "description": "Search depth. Defaults to `advanced`.",
          "anyOf": [
            {
              "$ref": "#/$defs/TavilySearchDepthToml"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "TavilySearchDepthToml": {
      "type": "string",
      "enum": [
        "basic",
        "advanced"
      ]
    },
    "McpToml": {
      "type": "object",
      "properties": {
        "servers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/McpServerToml"
          },
          "default": {}
        },
        "proxy": {
          "description": "ee MCP proxy mode (off by default).",
          "anyOf": [
            {
              "$ref": "#/$defs/McpProxyToml"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
